{
  "id": "reels",
  "label": "Instagram Reels",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "safe_zone_px": {
    "_note": "Texto solo en la banda 168–1330 px (guía de HyperFrames para 9:16: arriba la barra de estado, abajo descripción/usuario/botones, a la derecha el riel de acciones). Verificar con captura real.",
    "_verified": false,
    "top": 220,
    "bottom": 590,
    "left": 60,
    "right": 140
  },
  "cover": {
    "grid_crop": "4:5",
    "keep_title_inside_crop": true
  },
  "duration_s": {
    "target_min": 20,
    "target_max": 75,
    "short_max": 30
  },
  "pacing": {
    "pause_after_sentence_s": 0.4,
    "hook_s": 2.0
  },
  "end": {
    "type": "cta",
    "default_cta": "compartir_o_guardar"
  },
  "export": {
    "container": "mp4",
    "vcodec": "h264",
    "profile": "high",
    "pix_fmt": "yuv420p",
    "video_bitrate": "16M",
    "acodec": "aac",
    "audio_bitrate": "192k",
    "audio_rate": 48000,
    "loudness_lufs": -14,
    "true_peak_db": -1
  },
  "copy": {
    "caption_max_chars": 2200,
    "hashtags": [
      3,
      5
    ],
    "style": "pulido, emocional, fácil de compartir; primera línea es el gancho"
  }
}
