#!/usr/bin/env python3
"""Genera docs/formats.md (catálogo de formatos de animación) desde el registro de formats/.

Uso: bin/format-catalog [--check]   (--check: exit 1 si docs/formats.md está desactualizado)
     bin/format-catalog --usage     qué formatos, efectos y transiciones usan las piezas de tus canales:
                                    «probado» (en una pieza entregada), «experimental» (solo en piezas sin
                                    entregar) o «sin uso». No toca docs/formats.md (es público).
"""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
import formats  # noqa: E402

OUT = ROOT / "docs" / "formats.md"


def build():
    packs = formats.available_packs()
    reg = formats.registry(packs)
    lines = ["# Catálogo de formatos de animación", "",
             "> Generado por `bin/format-catalog` desde `formats/`. No editar a mano.",
             "> Uso en `storyboard.json → scenes` (ver `docs/storyboard.md`). `core` está siempre disponible;",
             "> los paquetes se activan por canal en `channel.json → format_packs`.",
             "> Para verlos con la marca de un canal: `bin/format-gallery --channel <id>`.", ""]
    for pack in ["core", *packs]:
        items = {k: v for k, v in sorted(reg.items()) if v["pack"] == pack}
        if not items:
            continue
        lines += [f"## Paquete `{pack}`", ""]
        for name, m in items.items():
            doc = " ".join(m["doc"].split())
            lines += [f"### `{name}`", "", doc, "",
                      f"- Layout por defecto: `{m['layout']}`",
                      f"- Obligatorios: {', '.join(f'`{r}`' for r in m['required']) or '—'}",
                      *([f"- Librerías: {', '.join(f'`{n}`' for n in m['needs'])}"] if m.get("needs") else []),
                      "- Ejemplo:", "", "```json",
                      json.dumps({"id": f"s-{name}", "format": name, "in": 0.0, "out": 3.0, "params": m["example"]},
                                 ensure_ascii=False), "```", ""]
    return "\n".join(lines)


def usage():
    """Uso real por formato en las piezas de los canales de la persona (oslib.channel_roots)."""
    from scripts.core import oslib, state
    seen = {}
    for root in oslib.channel_roots():
        for sbf in sorted(root.glob("*/projects/*/storyboard.json")):
            P, channel = sbf.parent, sbf.parent.parent.parent.name
            if channel.startswith("_"):
                continue
            sb = json.loads(sbf.read_text(encoding="utf-8"))
            names = {s.get("format") for s in sb.get("scenes", []) if s.get("format")}
            names |= {f"fx:{x.get('type')}" for x in sb.get("fx", []) if x.get("type")}
            names |= {f"transition:{x.get('kind')}" for x in sb.get("transitions", []) if x.get("kind")}
            names |= {f"beat_fx:{x.get('fx')}" for x in sb.get("beat_fx", []) if x.get("fx")}
            delivered = state.load(P).get("stage") == "entregable"
            for n in names:
                row = seen.setdefault(n, {"pieces": 0, "channels": set(), "delivered": 0})
                row["pieces"] += 1
                row["channels"].add(channel)
                row["delivered"] += delivered
    reg = formats.registry(formats.available_packs())
    rows = []
    for name in sorted(set(reg) | set(seen)):
        u = seen.get(name, {"pieces": 0, "channels": set(), "delivered": 0})
        status = "probado" if u["delivered"] else "experimental" if u["pieces"] else "sin uso"
        rows.append({"format": name, "pack": reg.get(name, {}).get("pack"), "pieces": u["pieces"],
                     "channels": len(u["channels"]), "status": status})
    rows.sort(key=lambda r: ({"probado": 0, "experimental": 1, "sin uso": 2}[r["status"]], -r["pieces"], r["format"]))
    totals = {k: sum(r["status"] == k for r in rows) for k in ("probado", "experimental", "sin uso")}
    return {"ok": True, "totals": totals, "formats": rows}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--usage", action="store_true", help="uso real en las piezas de tus canales")
    args = ap.parse_args()
    if args.usage:
        print(json.dumps(usage(), ensure_ascii=False, indent=2))
        return
    text = build()
    if args.check:
        ok = OUT.exists() and OUT.read_text(encoding="utf-8") == text
        print(json.dumps({"ok": ok, "file": str(OUT.relative_to(ROOT))}))
        sys.exit(0 if ok else 1)
    OUT.write_text(text, encoding="utf-8")
    print(json.dumps({"ok": True, "file": str(OUT.relative_to(ROOT)), "formats": len(formats.registry(formats.available_packs()))}))


if __name__ == "__main__":
    main()
