#!/usr/bin/env python3
"""Abre archivos locales para revisión y siempre muestra sus rutas absolutas."""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from scripts.core.reviewlib import open_files  # noqa: E402

ap = argparse.ArgumentParser(description=__doc__)
ap.add_argument("files", nargs="+", help="archivos o carpetas que debe revisar la persona")
ap.add_argument("--json", action="store_true")
args = ap.parse_args()
results = open_files(args.files)
if args.json:
    print(json.dumps({"ok": True, "files": results}, ensure_ascii=False, indent=2))
else:
    for item in results:
        print(f"{'Abierto' if item['opened'] else 'Abrir manualmente'}: {item['path']}"
              + (f" ({item['reason']})" if item.get("reason") else ""))
