#!/usr/bin/env bash
# VideoVibe — demo de punta a punta en el canal de ejemplo (ver scripts/tools/demo.py --help).
# Uso: bin/demo [--quick] [--lang es|en]
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[ -x "$ROOT/.venv/bin/python" ] || { echo "Primero: bin/setup" >&2; exit 1; }
cd "$ROOT"
exec "$ROOT/.venv/bin/python" -m scripts.tools.demo "$@"
